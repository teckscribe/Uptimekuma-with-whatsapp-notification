# Shared authorization token between Uptime Kuma webhook header (x-hook-token) and whatsapp-bot
HOOK_TOKEN=your_secure_token_here

# Uptime Kuma image. Leave unset to pull the pinned official release. Set this
# only if you have mirrored the image to your own registry, e.g.
#   UPTIME_KUMA_IMAGE=ghcr.io/teckscribe/uptime-kuma:2.0.2
#UPTIME_KUMA_IMAGE=
