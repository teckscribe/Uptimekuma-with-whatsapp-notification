# This repo is edited on Windows and deployed on Linux. Anything Linux
# executes or parses must stay LF regardless of the cloning machine's
# core.autocrlf, or shell scripts fail with "\r: command not found".
* text=auto
*.sh        text eol=lf
Dockerfile* text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
.env*       text eol=lf
.npmrc      text eol=lf
