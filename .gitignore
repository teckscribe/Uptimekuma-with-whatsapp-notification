# ==============================================================================
# Git Ignore Configuration for docker-stack
# Protects sensitive operational data, credentials, and authentication sessions
# ==============================================================================

# Environment files and secrets
.env
.env.local
.env.*.local

# Live runtime databases, logs, and screenshots (Contains host IPs, monitor URLs, passwords)
uptime-kuma-data/
*.log

# WhatsApp Web authenticated session (Contains session keys, credentials, contact chats)
whatsapp-bot/wwebjs_auth/
wwebjs_auth/

# Real routing table (Contains real phone numbers & infrastructure site names)
whatsapp-bot/host_map.json

# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Build artifacts & temp files
dist/
dist-backup/
.cache/
